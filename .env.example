# ==================================
# 服务器配置
# ==================================

# 服务器主机和端口
PORT=3001
HOST=0.0.0.0

# 服务器超时设置（单位：秒）
SERVER_READ_TIMEOUT=60
SERVER_WRITE_TIMEOUT=600
SERVER_IDLE_TIMEOUT=120
SERVER_GRACEFUL_SHUTDOWN_TIMEOUT=10

# ==================================
# 集群配置
# ==================================

# 设置为 true 表示集群中的从节点
IS_SLAVE=false

# ==================================
# 本地化配置
# ==================================

# 时区设置
TZ=Asia/Shanghai

# ==================================
# 安全配置
# ==================================

# 身份验证密钥，用于保护管理 API 和界面
# 请使用长随机字符串以确保安全
AUTH_KEY=load-123456

# ENCRYPTION_KEY 用于加密静态存储的 API 密钥
# 可填写任意字符串，留空则禁用加密
ENCRYPTION_KEY=Gx5r0wR2pycBu8bphLmt4BPkHteuXton

# ==================================
# 数据库配置
# ==================================

# 数据库连接字符串（留空则使用 SQLite，数据库文件位于 ./data/gpt-load.db）
# MySQL 示例：
# DATABASE_DSN=root:123456@tcp(mysql:3306)/gpt-load?charset=utf8mb4&parseTime=True&loc=Local
# PostgreSQL 示例：
# DATABASE_DSN=postgres://postgres:123456@postgres:5432/gpt-load?sslmode=disable
DATABASE_DSN=

# ==================================
# 缓存配置
# ==================================

# Redis 连接字符串（留空则使用内存存储）
# 示例：redis://redis:6379/0
REDIS_DSN=

# ==================================
# 性能配置
# ==================================

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=100

# ==================================
# 跨域资源共享（CORS）配置
# ==================================

# 启用跨域资源共享
ENABLE_CORS=true
ALLOWED_ORIGINS=*
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*
ALLOW_CREDENTIALS=false

# ==================================
# 日志配置
# ==================================

# 日志级别（可选值：debug, info, warn, error）
LOG_LEVEL=info
# 日志格式（可选值：text, json）
LOG_FORMAT=text
# 启用文件日志
LOG_ENABLE_FILE=true
# 日志文件路径
LOG_FILE_PATH=./data/logs/app.log
